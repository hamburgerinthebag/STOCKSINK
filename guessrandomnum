#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void guessRandomNum() {
    printf("Welcome to the Random Number Guessing Game!\n");
    printf("I have selected a random number between 1 and 100. Can you guess it?\n");
    printf("You have 10 attempts to guess the number. Good luck!\n");
}

int main() {
    srand(time(NULL));
    guessRandomNum();
    int randomNum = (rand() % 100) + 1;

    int userGuess;
    int attempts = 10;

    printf("Enter your first guess: ");
    if (scanf("%d", &userGuess) != 1) {
        printf("Invalid input. Please enter a number.\n");
        while (getchar() != '\n'); 
        return 1;
    }

    while (attempts > 0) {
        // STEP 1: Immediately validate the boundaries of the guess
        if (userGuess < 1 || userGuess > 100) {
            printf("Out of bounds! Please enter a number between 1 and 100.\n");
            // We don't penalize their attempts for a typo, just ask again!
            printf("Enter your guess: ");
            if (scanf("%d", &userGuess) != 1) {
                printf("Invalid input. Please enter a number.\n");
                while (getchar() != '\n');
                return 1;
            }
            continue; 
        }

        
        if (userGuess == randomNum) {
            printf("Congratulations! You've guessed the number!\n");
            return 0;
        } else if (userGuess < randomNum) {
            printf("Too low! Try again.\n");
        } else {
            printf("Too high! Try again.\n");
        }

        attempts--;

        if (attempts == 0) {
            break; 
        }

        
        printf("You have %d attempts left. Enter your new guess: ", attempts);
        if (scanf("%d", &userGuess) != 1) {
            printf("Invalid input. Please enter a number.\n");
            while (getchar() != '\n'); 
            return 1;
        }
    } 
    printf("Sorry, you've used all your attempts! The number was %d.\n", randomNum); 
    return 0;     
}
